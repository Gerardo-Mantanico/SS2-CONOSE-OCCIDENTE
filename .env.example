
# =============================================================================
# Copiar este archivo en un .env y editar los valores para el entorno de ejecución.
#
# Uso según:
#   con Docker:  Levantar docker compose y usar los valores por defecto de abajo sin cambiar nada.
#   en Local:   Ajustar host, puerto y credenciales de la instalación de PostgreSQL.
# =============================================================================

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bd_nacional
DB_USER=postgres
DB_PASSWORD=postgres

# --- Flyway ---
# FLYWAY_URL se construye a partir de las variables de arriba.
# FLYWAY_USER y FLYWAY_PASSWORD reutilizan el mismo usuario de la BD.
FLYWAY_URL="jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}"
FLYWAY_USER="${DB_USER}"
FLYWAY_PASSWORD="${DB_PASSWORD}"

# --- ETL Python ---
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

# Solo aplica si Flyway corre en Docker. Host para alcanzar Postgres:
#   Postgres también en Docker:  postgres
#   Postgres local en el host:   host.docker.internal
FLYWAY_DOCKER_HOST=postgres